# Gateway auth token (created by scripts/setup-openclaw.sh)
OPENCLAW_TOKEN=
# Optional: override gateway/model targets
OPENCLAW_GATEWAY=http://127.0.0.1:18789
BABBLE_MODEL=openclaw/babble
BABBLE_BACKEND=moonshotai-kimi-k3.1-pro-trial
BABBLE_AGENT=babble
# Agent workspace used for pet memory files (memory/pets/<pet>.md)
# BABBLE_WORKSPACE=agent-workspace
# Optional: the "race" side-by-side lane, another OpenClaw agent on a
# different backend. /api/compare answers 501 until this agent exists.
# RIVAL_AGENT=babble-gpu
# RIVAL_BACKEND=nebius/moonshotai/Kimi-K3.1-Pro
# RIVAL_LABEL=Nebius · GPU
